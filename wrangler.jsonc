{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apppp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9adb7086-7729-4a2e-9e7d-57a924cf4421","database_name": "web-apppp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "47e340892411496694cbd4495ebfc689" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
